# 로컬에서 `npm run dev:vercel` + 관리자 API를 쓰려면 아래를 참고해 `.env.local` 을 만드세요.
# Vercel에 이미 올린 변수가 있으면:  npx vercel env pull .env.local

# --- 관리자 (서버 API: /api/admin/*, 결제 스킵 등) ---
# 쉼표로 여러 이메일 가능. 반드시 소문자로 비교됩니다.
ADMIN_EMAILS=your-admin@example.com

# --- 관리자 UI (선택, 더 이상 권한 판별에 쓰이지 않음 — 권한은 서버 ADMIN_EMAILS + /api/admin/admin-session) ---
# VITE_ADMIN_EMAILS=your-admin@example.com

# --- Supabase: 브라우저(Vite) + 서버리스 공통 ---
# 프로덕션·로컬 모두 필수 (저장소에 키를 넣지 마세요)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# impersonate-login, 결제 콜백 등에 필요
SUPABASE_SERVICE_ROLE_KEY=

# --- Open Redirect 방지: magic link redirectTo 허용 오리진 (쉼표 구분, 프로덕션 필수 권장) ---
# ALLOWED_ORIGINS=https://www.slam-global.com,https://slam-global.com
# 또는 단일: SITE_ORIGIN=https://www.slam-global.com
#
# CPM 전용 페이지(/cpm)를 서브도메인 배포 후에 붙였다면 동일 변수에 그 오리진을 포함하세요
# 예: ALLOWED_ORIGINS=https://www.slam-global.com,https://cpm.slam-global.com

# --- CPM 라인: 검수 SaaS(2번) 웹훅 수신 검증 ---
# 배포 후 Vercel에 설정: 검수 플랫폼과 동일한 시크릿을 공유
# CPMS_REVIEW_WEBHOOK_SECRET=

# --- 선택: 순수 Vite(`npm run dev`)만 쓰고 API는 다른 포트일 때 ---
# VITE_DEV_API_PROXY=http://127.0.0.1:3001

# --- 선택: UUID로 납품 리스트만 연결할 때 (docs/supabase-setup-ko.md 참고) ---
# VITE_LINKED_DELIVERY_CAMPAIGN_ID=
# VITE_LINKED_DELIVERY_LIST_SLUG=BS-US-FARMSKIN
# 웰코스 MX: BS-MX-WELCOS
